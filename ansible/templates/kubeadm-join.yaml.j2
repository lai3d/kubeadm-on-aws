apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
discovery:
  bootstrapToken:
    apiServerEndpoint: "{{ control_plane_private_ip }}:6443"
    token: "{{ join_token }}"
    caCertHashes:
      - "{{ ca_cert_hash }}"
nodeRegistration:
  kubeletExtraArgs:
    - name: cloud-provider
      value: external
