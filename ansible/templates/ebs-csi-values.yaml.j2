controller:
  replicaCount: 1
  region: "{{ aws_region }}"
  # Tags every volume with kubernetes.io/cluster/<name>, so orphans are findable.
  k8sTagClusterId: "{{ cluster_name }}"

storageClasses:
  - name: gp3
    annotations:
      storageclass.kubernetes.io/is-default-class: "true"
    # EBS volumes are zonal: wait for the pod to be scheduled, then create the
    # volume in that node's AZ - otherwise the volume can land in the wrong one.
    volumeBindingMode: WaitForFirstConsumer
    reclaimPolicy: Delete
    allowVolumeExpansion: true
    parameters:
      type: gp3
      encrypted: "true"
